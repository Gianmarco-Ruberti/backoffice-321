{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contrat/envelope",
  "title": "Enveloppe",
  "type": "object",
  "required": ["v", "id", "from", "to", "ts", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "from": { "type": "string", "minLength": 1, "description": "nom du nœud émetteur" },
    "to": { "type": "string", "minLength": 1, "description": "nom d'un nœud, ou * pour tous" },
    "ts": { "type": "string", "format": "date-time", "description": "UTC, ISO 8601" },
    "type": { "enum": ["time", "log"], "description": "nom du schéma du payload ; limité à time et log pour le moment" },
    "payload": { "type": "object" }
  }
}
